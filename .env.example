# Frontend → Backend integration
# Base URL of the Spring Boot API (no trailing slash).
VITE_API_URL=http://localhost:8080/api/v1

# Optional: request timeout for axios in milliseconds.
VITE_API_TIMEOUT_MS=20000

# Optional: when "1", the legacy in-memory mock transport is used.
# Production builds MUST leave this unset or "0".
VITE_USE_MOCK_API=0